// Prelude: visible in every module. Functions without a body are
// intrinsics implemented in runtime/nicethon.h.

enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    fn unwrap(self) -> T {
        match self {
            Some(value) => value,
            None => panic("called unwrap on None"),
        }
    }

    fn unwrap_or(self, fallback: T) -> T {
        match self {
            Some(value) => value,
            None => fallback,
        }
    }

    fn is_some(self) -> Bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    fn is_none(self) -> Bool {
        !self.is_some()
    }

    fn map<U>(self, function: (T) -> U) -> Option<U> {
        match self {
            Some(value) => Some(function(value)),
            None => None,
        }
    }
}

enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    fn unwrap(self) -> T {
        match self {
            Ok(value) => value,
            Err(_) => panic("called unwrap on Err"),
        }
    }

    fn unwrap_or(self, fallback: T) -> T {
        match self {
            Ok(value) => value,
            Err(_) => fallback,
        }
    }

    fn is_ok(self) -> Bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    fn is_err(self) -> Bool {
        !self.is_ok()
    }

    fn ok(self) -> Option<T> {
        match self {
            Ok(value) => Some(value),
            Err(_) => None,
        }
    }

    fn map<U>(self, function: (T) -> U) -> Result<U, E> {
        match self {
            Ok(value) => Ok(function(value)),
            Err(error) => Err(error),
        }
    }

    fn map_err<F>(self, function: (E) -> F) -> Result<T, F> {
        match self {
            Ok(value) => Ok(value),
            Err(error) => Err(function(error)),
        }
    }
}

struct PyErr {
    message: Str;
    type_name: Str;
    value: Dyn;
}

trait Eq {}
trait Ord {}
trait Hash {}
trait Show {}

fn print<T>(value: T);
fn panic(message: Str) -> Never;
fn str<T>(value: T) -> Str;
fn sum<T>(items: List<T>) -> T;

fn map<T, U>(items: List<T>, function: (T) -> U) -> List<U> {
    items.map(function)
}

fn filter<T>(items: List<T>, keep: (T) -> Bool) -> List<T> {
    items.filter(keep)
}

fn fold<T, A>(items: List<T>, initial: A, function: (A, T) -> A) -> A {
    items.fold(initial, function)
}

impl<T> List<T> {
    fn iter(self) -> ListIter<T> {
        ListIter(items = self, position = cell(0))
    }

    fn zip<V>(self, other: List<V>) -> Zipped<ListIter<T>, ListIter<V>, T, V> {
        self.iter().zip(other.iter())
    }

    fn enumerate(self) -> Enumerated<ListIter<T>, T> {
        self.iter().enumerate()
    }

    fn len(self) -> Int;
    fn push(self, item: T);
    fn pop(self) -> Option<T>;
    fn sort_by<K>(self, key: (T) -> K) -> List<T>;
    fn sorted(self) -> List<T>;
    fn reversed(self) -> List<T>;
    fn join(self, separator: Str) -> Str;

    fn is_empty(self) -> Bool {
        self.len() == 0
    }

    fn get(self, index: Int) -> Option<T> {
        if index >= 0 && index < self.len() { Some(self[index]) } else { None }
    }

    fn contains(self, item: T) -> Bool {
        item in self
    }

    fn map<U>(self, function: (T) -> U) -> List<U> {
        let result: List<U> = [];
        for item in self {
            result.push(function(item));
        }
        result
    }

    fn filter(self, keep: (T) -> Bool) -> List<T> {
        let result: List<T> = [];
        for item in self {
            if keep(item) {
                result.push(item);
            }
        }
        result
    }

    fn fold<A>(self, initial: A, function: (A, T) -> A) -> A {
        var total = initial;
        for item in self {
            total = function(total, item);
        }
        total
    }

    fn any(self, check: (T) -> Bool) -> Bool {
        for item in self {
            if check(item) {
                return true;
            }
        }
        false
    }

    fn all(self, check: (T) -> Bool) -> Bool {
        for item in self {
            if !check(item) {
                return false;
            }
        }
        true
    }
}

impl Str {
    fn len(self) -> Int;
    fn upper(self) -> Str;
    fn lower(self) -> Str;
    fn trim(self) -> Str;
    fn split(self, separator: Str) -> List<Str>;
    fn replace(self, old: Str, new: Str) -> Str;
    fn starts_with(self, prefix: Str) -> Bool;
    fn ends_with(self, suffix: Str) -> Bool;
    fn parse_int(self) -> Option<Int>;
    fn parse_float(self) -> Option<Float>;

    fn is_empty(self) -> Bool {
        self.len() == 0
    }

    fn contains(self, part: Str) -> Bool {
        part in self
    }
}

impl Int {
    fn abs(self) -> Int {
        if self < 0 { -self } else { self }
    }

    fn min(self, other: Int) -> Int {
        if self < other { self } else { other }
    }

    fn max(self, other: Int) -> Int {
        if self > other { self } else { other }
    }
}

impl Float {
    fn min(self, other: Float) -> Float {
        if self < other { self } else { other }
    }

    fn max(self, other: Float) -> Float {
        if self > other { self } else { other }
    }

    fn floor(self) -> Float;
    fn ceil(self) -> Float;
    fn sqrt(self) -> Float;
    fn abs(self) -> Float;
    fn round(self) -> Float;
}

impl<K, V> Map<K, V> {
    fn len(self) -> Int;
    fn get(self, key: K) -> Option<V>;
    fn remove(self, key: K) -> Option<V>;
    fn keys(self) -> List<K>;
    fn values(self) -> List<V>;

    fn contains(self, key: K) -> Bool {
        key in self
    }
}

// Cell: a mutable slot inside an immutable value, used for iterator state.
// Copies of a value share its cells.

struct Cell<T> {
    value: T;
}

fn cell<T>(value: T) -> Cell<T> {
    Cell(value = value)
}

impl<T> Cell<T> {
    fn get(self) -> T;
    fn set(self, value: T);
}

// Iterator: a type only provides next, all other methods build on it.
// The adapters are lazy, they pull one item from their source per next.

trait Iterator<T> {
    fn next(self) -> Option<T>;

    fn map<U>(self, function: (T) -> U) -> Mapped<Self, T, U> {
        Mapped(source = self, function = function)
    }

    fn filter(self, keep: (T) -> Bool) -> Filtered<Self, T> {
        Filtered(source = self, keep = keep)
    }

    fn zip<J: Iterator<V>, V>(self, other: J) -> Zipped<Self, J, T, V> {
        Zipped(left = self, right = other)
    }

    fn enumerate(self) -> Enumerated<Self, T> {
        Enumerated(source = self, index = cell(0))
    }

    fn take(self, count: Int) -> Taken<Self, T> {
        Taken(source = self, remaining = cell(count))
    }

    fn skip(self, count: Int) -> Skipped<Self, T> {
        Skipped(source = self, remaining = cell(count))
    }

    fn chain<J: Iterator<T>>(self, other: J) -> Chained<Self, J, T> {
        Chained(first = self, second = other, first_done = cell(false))
    }

    fn collect(self) -> List<T> {
        let result: List<T> = [];
        for item in self {
            result.push(item);
        }
        result
    }

    fn fold<A>(self, initial: A, function: (A, T) -> A) -> A {
        var total = initial;
        for item in self {
            total = function(total, item);
        }
        total
    }

    fn count(self) -> Int {
        var total = 0;
        for _ in self {
            total += 1;
        }
        total
    }

    fn any(self, check: (T) -> Bool) -> Bool {
        for item in self {
            if check(item) {
                return true;
            }
        }
        false
    }

    fn all(self, check: (T) -> Bool) -> Bool {
        for item in self {
            if !check(item) {
                return false;
            }
        }
        true
    }

    fn find(self, check: (T) -> Bool) -> Option<T> {
        for item in self {
            if check(item) {
                return Some(item);
            }
        }
        None
    }

    fn for_each(self, action: (T) -> ()) {
        for item in self {
            action(item);
        }
    }
}

struct ListIter<T> {
    items: List<T>;
    position: Cell<Int>;
}

impl<T> Iterator<T> for ListIter<T> {
    fn next(self) -> Option<T> {
        let position = self.position.get();
        if position >= self.items.len() {
            return None;
        }
        self.position.set(position + 1);
        Some(self.items[position])
    }
}

struct Counter {
    current: Cell<Int>;
    end: Int;
}

// Lazy range: range(0, 3) yields 0, 1, 2 without building a list.
fn range(start: Int, end: Int) -> Counter {
    Counter(current = cell(start), end = end)
}

impl Iterator<Int> for Counter {
    fn next(self) -> Option<Int> {
        let value = self.current.get();
        if value >= self.end {
            return None;
        }
        self.current.set(value + 1);
        Some(value)
    }
}

struct Mapped<I, T, U> {
    source: I;
    function: (T) -> U;
}

impl<I: Iterator<T>, T, U> Iterator<U> for Mapped<I, T, U> {
    fn next(self) -> Option<U> {
        match self.source.next() {
            Some(value) => Some(self.function(value)),
            None => None,
        }
    }
}

struct Filtered<I, T> {
    source: I;
    keep: (T) -> Bool;
}

impl<I: Iterator<T>, T> Iterator<T> for Filtered<I, T> {
    fn next(self) -> Option<T> {
        loop {
            match self.source.next() {
                Some(value) => {
                    if self.keep(value) {
                        return Some(value);
                    }
                }
                None => return None,
            }
        }
    }
}

struct Zipped<I, J, T, V> {
    left: I;
    right: J;
}

impl<I: Iterator<T>, J: Iterator<V>, T, V> Iterator<(T, V)> for Zipped<I, J, T, V> {
    // Like Python's zip: the right side is only pulled when the left had an item.
    fn next(self) -> Option<(T, V)> {
        match self.left.next() {
            Some(left) => match self.right.next() {
                Some(right) => Some((left, right)),
                None => None,
            },
            None => None,
        }
    }
}

struct Enumerated<I, T> {
    source: I;
    index: Cell<Int>;
}

impl<I: Iterator<T>, T> Iterator<(Int, T)> for Enumerated<I, T> {
    fn next(self) -> Option<(Int, T)> {
        match self.source.next() {
            Some(value) => {
                let index = self.index.get();
                self.index.set(index + 1);
                Some((index, value))
            }
            None => None,
        }
    }
}

struct Taken<I, T> {
    source: I;
    remaining: Cell<Int>;
}

impl<I: Iterator<T>, T> Iterator<T> for Taken<I, T> {
    fn next(self) -> Option<T> {
        let remaining = self.remaining.get();
        if remaining <= 0 {
            return None;
        }
        self.remaining.set(remaining - 1);
        self.source.next()
    }
}

struct Skipped<I, T> {
    source: I;
    remaining: Cell<Int>;
}

impl<I: Iterator<T>, T> Iterator<T> for Skipped<I, T> {
    fn next(self) -> Option<T> {
        while self.remaining.get() > 0 {
            self.remaining.set(self.remaining.get() - 1);
            self.source.next();
        }
        self.source.next()
    }
}

struct Chained<I, J, T> {
    first: I;
    second: J;
    first_done: Cell<Bool>;
}

impl<I: Iterator<T>, J: Iterator<T>, T> Iterator<T> for Chained<I, J, T> {
    fn next(self) -> Option<T> {
        if !self.first_done.get() {
            match self.first.next() {
                Some(value) => return Some(value),
                None => self.first_done.set(true),
            }
        }
        self.second.next()
    }
}

