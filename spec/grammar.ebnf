(* Nicethon grammar.

   Notation:
     { x }   zero or more
     [ x ]   optional
     "x"     literal token
     UPPER   token class produced by the lexer

   Meaning of programs is in semantics.md. Notes marked "parser:" describe
   how ambiguous spots are resolved. *)


(* Lexer *)

(* Whitespace and newlines carry no meaning. Statements end with ";".

   Comments:
     //  to end of line
     /*  */ block comment, may nest
     /// doc comment, attaches to the next item

   "//" is never an operator. Floor division is "~/". *)

IDENT        = ( letter | "_" ) { letter | digit | "_" } ;    (* ASCII letters only *)
INT          = dec_int | "0x" hex_digit { hex_digit | "_" }
                       | "0o" oct_digit { oct_digit | "_" }
                       | "0b" bin_digit { bin_digit | "_" } ;
dec_int      = digit { digit | "_" } ;
FLOAT        = dec_int "." dec_int [ exponent ] | dec_int exponent ;
exponent     = ( "e" | "E" ) [ "+" | "-" ] dec_int ;
STRING       = '"' { string_char | escape } '"' ;
BYTES        = 'b"' { byte_char | escape } '"' ;
TEMPLATE     = "`" { template_char | escape | "${" expr "}" } "`" ;
escape       = "\" ( "n" | "t" | "r" | "0" | "\" | '"' | "`" | "$"
                   | "x" hex_digit hex_digit
                   | "u{" hex_digit { hex_digit } "}" ) ;

(* Keywords. They are still allowed as member names after ".", as
   named-argument names in calls and as names inside import braces (there
   "as" is required), because Python uses many of them: re.match, np.var,
   tensor.type, f(type = ...). *)
(*
   as async await break catch class const continue else enum export extern
   false finally fn for from if impl import in let loop match py return
   self Self struct super throw trait true try type var while with
*)

(* Multi-character tokens, longest match wins:
   as!  as?  =>  ->  |>  ..  ..=  ...  ==  !=  <=  >=  &&  ||  **  ~/
   <<  >>  +=  -=  *=  /=  ~/=  %=  **=  @=  &=  |=  ^=  <<=  >>=
   "as!" and "as?" are single tokens only without whitespace in between.
   There is no "::" token; "::2" in a slice is ":" ":" "2". *)


(* Modules *)

module          = { import_decl } { item } EOF ;

import_decl     = "import" [ "py" ] import_clause "from" STRING ";" ;
import_clause   = "*" "as" IDENT [ "," named_imports ]
                | named_imports ;
named_imports   = "{" [ import_spec { "," import_spec } [ "," ] ] "}" ;
import_spec     = name [ "as" IDENT ] ;
name            = IDENT | keyword ;          (* keyword only together with "as" *)

(* Examples:
     import py * as np from "numpy";
     import py { sqrt, pi as PI } from "math";
     import py * as F, { relu } from "torch.nn.functional";
     import py { match as regex_match } from "re";
     import { Point, norm } from "./geometry";          // Nicethon module *)


(* Items *)

item            = { decorator } [ "export" ] item_body ;
item_body       = fn_decl
                | struct_decl
                | enum_decl
                | trait_decl
                | impl_decl
                | const_decl
                | type_alias
                | extern_block
                | py_class ;
decorator       = "@" postfix_expr ;          (* only before fn_decl and py_class *)

fn_decl         = fn_sig block ;
fn_sig          = [ "async" ] "fn" IDENT [ generic_params ]
                  "(" [ param { "," param } [ "," ] ] ")" [ "->" type ] ;
param           = "self"
                | [ "var" ] IDENT [ "?" ] ":" type [ "=" expr ]
                | "*" IDENT ":" type          (* python *args, extern and py class only *)
                | "**" IDENT ":" type ;       (* python **kwargs, extern and py class only *)
(* "?" after a parameter name: may be omitted by the caller, and is then
   not passed to Python at all. Only allowed in extern blocks. *)

generic_params  = "<" generic_param { "," generic_param } [ "," ] ">" ;
generic_param   = IDENT [ ":" path_type { "+" path_type } ] ;

struct_decl     = "struct" IDENT [ generic_params ] "{" { field_decl } "}" ;
field_decl      = IDENT ":" type [ "=" expr ] ";" ;

enum_decl       = "enum" IDENT [ generic_params ]
                  "{" [ variant { "," variant } [ "," ] ] "}" ;
variant         = IDENT [ "(" variant_field { "," variant_field } [ "," ] ")" ] ;
variant_field   = [ IDENT ":" ] type ;

trait_decl      = "trait" IDENT [ generic_params ] "{" { trait_member } "}" ;
trait_member    = fn_sig ( ";" | block ) ;    (* block = default implementation *)

impl_decl       = "impl" [ generic_params ] [ path_type "for" ] type
                  "{" { { decorator } [ "export" ] fn_decl } "}" ;

const_decl      = "const" IDENT ":" type "=" expr ";" ;
type_alias      = "type" IDENT [ generic_params ] "=" type ";" ;

extern_block    = "extern" "py" STRING "{" { extern_member } "}" ;
extern_member   = fn_sig ";"
                | "const" IDENT ":" type ";"
                | "type" IDENT [ generic_params ] [ ":" path_type { "," path_type } ]
                  "{" { extern_type_member } "}" ;
extern_type_member
                = name ":" type ";"           (* attribute *)
                | fn_sig ";" ;                (* method, first parameter is self *)

py_class        = "py" "class" IDENT [ ":" postfix_expr { "," postfix_expr } ]
                  "{" { py_class_member } "}" ;
py_class_member = field_decl
                | { decorator } fn_decl ;


(* Types *)

type            = paren_type | path_type ;
path_type       = IDENT { "." IDENT } [ type_args ] ;
type_args       = "<" type { "," type } [ "," ] ">" ;
paren_type      = "(" [ type { "," type } [ "," ] ] ")" [ "->" type ] ;
(* paren_type meaning:
     ()              unit
     (T)             T
     (T,)  (A, B)    tuples
     (A, B) -> R     function type, also () -> R *)


(* Statements and blocks *)

block           = "{" { stmt } [ expr ] "}" ;
(* The value of a block is its last expression if it has no ";",
   otherwise (). *)

stmt            = ";"
                | let_stmt
                | var_stmt
                | assign_stmt
                | try_stmt
                | with_stmt
                | block_like                  (* no ";" needed *)
                | expr ";"
                | item ;                      (* nested functions and types *)

block_like      = block | if_expr | match_expr | while_expr | for_expr | loop_expr ;
(* parser: a block_like at the start of a statement ends the statement,
   unless it is the last thing in the enclosing block, then it is the
   block's value (same rule as Rust). *)

let_stmt        = "let" pattern [ ":" type ] "=" expr ";" ;
(* In a let pattern, "name: Type" is not a type test; the ":" belongs to the
   let. Let patterns must be irrefutable (cannot fail). *)
var_stmt        = "var" IDENT [ ":" type ] "=" expr ";" ;
assign_stmt     = postfix_expr assign_op expr ";" ;
assign_op       = "=" | "+=" | "-=" | "*=" | "/=" | "~/=" | "%=" | "**=" | "@="
                | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

try_stmt        = "try" block { catch_clause } [ "finally" block ] ;
catch_clause    = "catch" "(" IDENT [ ":" postfix_expr { "|" postfix_expr } ] ")" block ;

with_stmt       = "with" with_item { "," with_item } block ;
with_item       = expr [ "as" IDENT ] ;
(* parser: inside a with_item, a plain "as" is never parsed as a cast.
   Use parentheses for a cast there. *)


(* Expressions, lowest precedence first *)

expr            = lambda
                | jump_expr
                | try_expr
                | pipe_expr ;

lambda          = lambda_params "=>" ( block | assignment | expr ) ;
lambda_params   = IDENT
                | "(" [ IDENT [ ":" type ] { "," IDENT [ ":" type ] } [ "," ] ] ")" ;
(* parser: "(" starts either a parenthesized expression, a tuple or lambda
   parameters. Parse it as an expression and reinterpret it as parameters
   when "=>" follows (cover grammar, like JavaScript). *)

jump_expr       = "return" [ expr ]
                | "break" [ expr ]
                | "continue"
                | "throw" expr ;
(* Type Never, so they work inside match arms and if branches. *)

try_expr        = "try" pipe_expr ;
(* parser: "try" followed by "{" is always try_stmt. *)

pipe_expr       = range_expr { "|>" range_expr } ;
range_expr      = or_expr [ ( ".." | "..=" ) or_expr ] ;
or_expr         = and_expr { "||" and_expr } ;
and_expr        = cmp_expr { "&&" cmp_expr } ;
cmp_expr        = bitor_expr [ cmp_op bitor_expr ] ;      (* not chainable *)
cmp_op          = "==" | "!=" | "<" | "<=" | ">" | ">=" | "in" ;
bitor_expr      = bitxor_expr { "|" bitxor_expr } ;
bitxor_expr     = bitand_expr { "^" bitand_expr } ;
bitand_expr     = shift_expr { "&" shift_expr } ;
shift_expr      = add_expr { ( "<<" | ">>" ) add_expr } ;
add_expr        = mul_expr { ( "+" | "-" ) mul_expr } ;
mul_expr        = cast_expr { ( "*" | "/" | "~/" | "%" | "@" ) cast_expr } ;
cast_expr       = unary_expr { ( "as" | "as!" | "as?" ) type } ;
unary_expr      = ( "-" | "!" | "~" | "await" ) unary_expr
                | power_expr ;
power_expr      = postfix_expr [ "**" unary_expr ] ;      (* right assoc, -x ** 2 == -(x ** 2) *)

postfix_expr    = primary { call_suffix | index_suffix | member_suffix | "?" } ;
member_suffix   = "." ( name | INT ) ;                    (* INT: tuple field, point.0 *)
(* lexer: "pair.0.1" would lex "0.1" as FLOAT; the lexer splits a FLOAT
   directly after "." into INT "." INT. *)

call_suffix     = [ type_args ] "(" [ arg { "," arg } [ "," ] ] ")" ;
(* parser: explicit type arguments, parse<Int>(text), are tried
   speculatively: "<" types ">" must be followed by "(", otherwise "<" is
   a comparison. TypeScript does the same. *)
arg             = expr
                | name "=" expr                           (* named argument *)
                | "*" expr                                (* python positional spread *)
                | "**" expr ;                             (* python keyword spread *)

index_suffix    = "[" index_arg { "," index_arg } [ "," ] "]" ;
index_arg       = expr
                | [ expr ] ":" [ expr ] [ ":" [ expr ] ]  (* python slice *)
                | "..." ;                                 (* python Ellipsis *)

primary         = literal
                | TEMPLATE
                | IDENT
                | "self"
                | "Self"
                | "super"                                 (* py class methods only *)
                | "(" ")"                                 (* unit *)
                | "(" expr ")"
                | "(" expr "," [ expr { "," expr } [ "," ] ] ")"     (* tuple *)
                | list_lit
                | map_lit
                | block_like ;

literal         = INT | FLOAT | STRING | BYTES | "true" | "false" ;
list_lit        = "[" [ expr { "," expr } [ "," ] ] "]" ;
map_lit         = "[" ":" "]"
                | "[" expr ":" expr { "," expr ":" expr } [ "," ] "]" ;
(* parser: after the first element, ":" means map, "," or "]" means list.
   Slices only exist in index_suffix, so there is no conflict. *)

if_expr         = "if" condition block [ "else" ( if_expr | block ) ] ;
condition       = expr
                | "let" pattern "=" expr ;
while_expr      = "while" condition block ;
for_expr        = "for" pattern "in" expr block ;
loop_expr       = "loop" block ;

match_expr      = "match" expr "{" [ match_arm { "," match_arm } [ "," ] ] "}" ;
match_arm       = pattern [ "if" expr ] "=>" ( block | assignment | expr ) ;
assignment      = postfix_expr assign_op expr ;           (* becomes a block with one statement *)
(* The "," after an arm whose body is a block may be left out. *)


(* Patterns *)

pattern         = pattern_alt { "|" pattern_alt } ;
pattern_alt     = "_"
                | literal
                | "-" ( INT | FLOAT )
                | IDENT ":" type                          (* type test, Dyn only, not in let *)
                | path [ "(" [ sub_pattern { "," sub_pattern } [ "," ] ] ")" ]
                | "(" sub_pattern { "," sub_pattern } [ "," ] ")"   (* tuple *)
                | "[" [ sub_pattern { "," sub_pattern } [ "," ] ] "]" ;  (* list *)
sub_pattern     = pattern
                | ".."                                    (* rest *)
                | IDENT "=" pattern ;                     (* named field *)
path            = IDENT { "." IDENT } ;
(* A single IDENT is a unit variant if the matched type has a variant of
   that name (Empty, None), otherwise it binds a new variable. *)
