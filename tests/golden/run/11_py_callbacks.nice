// requires: numpy
// Nicethon lambdas and functions handed to python. A lambda passed to a Dyn
// parameter gets Dyn parameters unless annotated; annotated parameters are
// checked every time python calls in.
import py * as np from "numpy";
import py * as functools from "functools";
import py { sorted, TypeError } from "builtins";

fn score(word: Str) -> Int {
    word.len() * 10
}

fn main() {
    // numpy is Dyn, so value is Dyn
    print(np.vectorize(value => value * value)(np.arange(4)));

    // annotated: numpy calls with numpy.int64 first, then with python ints;
    // both pass the Int check (numpy integers through __index__)
    print(np.vectorize((value: Int) => value + 1)(np.arange(3)));

    // a failing check surfaces in python as TypeError
    try {
        np.vectorize((text: Str) => text.len())(np.arange(3));
    } catch (error: TypeError) {
        print(`TypeError: ${error.message}`);
    }

    // typed stdlib: the callback type comes from typeshed, the element type
    // from the list (lambdas are checked after the other arguments)
    print(functools.reduce((left, right) => left * right, [1, 2, 3, 4]));

    // named functions are python callables too
    print(sorted(["pear", "fig", "banana"], key = score));
}
